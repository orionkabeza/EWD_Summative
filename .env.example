# Optional overrides. The defaults work out of the box; copy to .env only if needed.
# (The app reads these from the real environment variables, e.g. `set PORT=5001` on Windows.)
PORT=5000
DATABASE_PATH=database/urban_mobility.db
ZONES_GEOJSON_PATH=data/processed/taxi_zones.geojson
# Longest a single query may run, in seconds (0 = no limit).
QUERY_TIME_LIMIT=15
# Pre-run the dashboard's opening queries when the server starts (0 = off).
WARM_UP=1
